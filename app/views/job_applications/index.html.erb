<main class="applications-page">
    <div class="applications-toolbar">
      <p class="eyebrow">Application tracker</p>
      <%= link_to new_manual_application_path, class: "btn recommend-btn" do %>
        <i class="fa-solid fa-plus"></i>
        <span> New Application</span>
      <% end %>
    </div>
    <section class="applications-board"
         aria-label="Applications grouped by status"
         data-controller="application-board">
  <% JobApplication.statuses.each_key do |status| %>
    <% applications = @job_applications.public_send(status) %>

    <section class="status-column"
             data-application-board-target="column"
             data-status="<%= JobApplication.statuses.fetch(status) %>"
             data-action="
               dragover->application-board#dragOver
               dragleave->application-board#dragLeave
               drop->application-board#drop
             ">
        <header class="status-header">
          <h2><%= status.humanize %></h2>
          <span><%= applications.size %></span>
        </header>

        <div class="application-list">
          <% applications.each do |application| %>
            <%= link_to job_application_path(application),
                class: "application-card application-card--#{status}",
                draggable: true,
                data: {
                  application_board_target: "card",
                  application_id: application.id,
                  status: application.status,
                  update_url: job_application_path(application),
                  action: [
                    "dragstart->application-board#dragStart",
                    "dragend->application-board#dragEnd"
                  ].join(" ")
                } do %>
              <div class="card-heading">
                    <span class="dashboard-job__mark" style="<%= application.job_opening.company.logo.attached? ? "background-image: url(#{cl_image_path(application.job_opening.company.logo.key, secure: true)})" : "background-color: rgba(0, 61, 150, 0.09)" %>"></span>
                <div>
                  <h3><%= application.job_opening.title %></h3>
                  <p><%= application.job_opening.company.name %></p>
                </div>
              </div>

              <%# <% if application.job_opening.location.present? %>
                <%# <p class="location"> %>
                  <%# <%= application.job_opening.location %>
                <%# </p> %>
              <%# <% end %>

              <time datetime="<%= application.created_at.to_date.iso8601 %>">
                <%= application.created_at.strftime("%b %-d") %>
              </time>

              <p class="task-count">
                <%= pluralize(application.tasks.size, "task") %>
              </p>
            <% end %>
          <% end %>

          <% if applications.empty? %>
            <p class="empty-column">No applications</p>
          <% end %>
        </div>
      </section>
    <% end %>
  </section>
</main>
